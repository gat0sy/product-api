# Starts the minikube cluster at boot on k8s-node, as the user that owns the profile.
# The workloads (mysql, product-api) are already defined in the cluster and come back on their own.
#
# Install:
#   sudo cp minikube.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable minikube.service
[Unit]
Description=minikube Kubernetes cluster
# minikube runs as a container on the docker driver; ordering after docker also
# means minikube is stopped before docker at shutdown
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=gatosy
Environment=HOME=/home/gatosy
Environment=MINIKUBE_IN_STYLE=false
Environment=MINIKUBE_WANTUPDATENOTIFICATION=false
ExecStart=/usr/local/bin/minikube start --interactive=false
ExecStop=/usr/local/bin/minikube stop
# Starting the control plane is slow on this VM (2 vCPUs)
TimeoutStartSec=900
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
